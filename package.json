{
  "name": "daxpay-h5",
  "type": "module",
  "version": "4.0.0-beta8",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "bootstrap": "pnpm install",
    "serve": "npm run dev",
    "dev": "cross-env VITE_CJS_IGNORE_WARNING=true vite dev",
    "dev:debugcjs": "cross-env VITE_CJS_TRACE=true vite dev",
    "build": "cross-env NODE_ENV=production vite build && tsx ./build/script/postBuild.ts",
    "build:no-cache": "pnpm clean:cache && npm run build",
    "report": "cross-env REPORT=true npm run build",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "preview": "vite preview",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:lib": "rimraf node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:lint-staged": "lint-staged"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "qs": "^6.15.2",
    "vant": "^4.9.24",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@unocss/eslint-plugin": "^66.7.2",
    "@unocss/preset-rem-to-px": "^66.7.2",
    "@unocss/reset": "^66.7.2",
    "@unocss/transformer-directives": "^66.7.2",
    "@unocss/transformer-variant-group": "^66.7.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^2.0.1",
    "fs-extra": "^11.3.5",
    "less": "^4.6.7",
    "lint-staged": "^15.2.0",
    "only-allow": "^1.2.2",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.15",
    "postcss-mobile-forever": "^4.0.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^5.11.0",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "unocss": "^66.7.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vconsole": "^3.15.1",
    "vite": "8.1.3",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^3.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": "eslint --fix"
  }
}
